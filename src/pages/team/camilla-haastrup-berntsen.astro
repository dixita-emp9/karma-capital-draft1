---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <section class="team-profile-section pt-20 pb-10">
    <div class="container">
      <div class="profile-header text-center mb-5 mt-5">
        <h1 class="text-display-3 text-primary mb-2">Camilla Haastrup Berntsen</h1>
        <p class="text-accent">CFO, MANAGING DIRECTOR</p>
      </div>

      <div class="profile-content row">
        <div class="col-image" style="flex: 1; max-width: 400px; margin: 0 auto;">
          <div class="img-wrapper" style="width: 100%; height: 500px; background-color: #e0e0e0; margin-bottom: 2rem;">
             <img src="/karma-capital/images/placeholder_founder1.jpg" alt="Camilla Haastrup Berntsen" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
        </div>
        
        <div class="col-info" style="flex: 2; padding: 0 2rem;">
          <h3 class="text-primary mb-3">About Camilla</h3>
          <p class="font-secondary mb-3" style="line-height: 1.8; color: #555;">
            Camilla Haastrup Berntsen brings deep financial expertise and strategic leadership to the firm. With extensive experience in managing financial operations and guiding strategic growth, she ensures robust financial health and operational excellence across the organization.
          </p>
          <p class="font-secondary" style="line-height: 1.8; color: #555;">
            Her leadership is instrumental in maintaining our high standards of transparency, compliance, and fiduciary responsibility. Camilla plays a pivotal role in shaping the strategic direction of the firm, enabling sustainable growth and long-term value creation.
          </p>
          
          <div class="contact-info mt-5 p-4" style="background-color: #f7f9fa; border-left: 4px solid #75b0e2;">
            <h4 class="text-primary mb-2">Contact</h4>
            <p class="font-secondary mb-1"><strong>Email:</strong> contact@karmacapital.co.in</p>
            <p class="font-secondary"><strong>LinkedIn:</strong> <a href="#" style="color: #75b0e2; text-decoration: underline;">View Profile</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .team-profile-section {
    padding-top: 120px; /* Space for fixed header */
    padding-bottom: 80px;
    background-color: #ffffff;
  }
  
  .text-display-3 {
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 300;
  }
  
  .text-accent {
    color: #75b0e2; /* Blue */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.95rem;
  }
  
  .profile-content {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    margin-top: 4rem;
    
    @media (max-width: 768px) {
      flex-direction: column;
      
      .col-info {
        padding: 0;
      }
    }
  }
</style>
