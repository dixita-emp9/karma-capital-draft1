---
import Layout from '../../layouts/Layout.astro';
import praveenImg from '../../assets/images/praveen-ladia.jpg';
---

<Layout>
  <div class="profile-page">

    <!-- Top Hero Strip -->
    <div class="profile-hero">
      <div class="container">
        <a href="/karma-capital/about#investment-core" class="back-link">← Back to Team</a>
      </div>
    </div>

    <!-- Profile Content -->
    <div class="profile-body">
      <div class="container">
        <div class="profile-grid">

          <!-- Left: Photo + Meta -->
          <div class="profile-left">
            <div class="profile-img-wrap">
              <img src={praveenImg.src} alt="Praveen Ladia" />
            </div>
            <div class="profile-meta">
              <h1 class="profile-name">Praveen Ladia</h1>
              <p class="profile-title">CHIEF EXECUTIVE OFFICER</p>
              <p class="profile-subtitle">The Architect of Scale</p>
            </div>
          </div>

          <!-- Right: Bio -->
          <div class="profile-right">
            <div class="bio-section">
              <p class="bio-text">
                Great investment strategies need robust platforms to reach the world. Praveen brings over 20 years of experience in scaling asset management firms from the ground up — transforming investment capabilities into sustainable, institutional-grade businesses.
              </p>
              <p class="bio-text">
                At Karma Capital, Praveen drives product strategy, distribution, and the operational excellence that institutional investors demand. Under his leadership, the firm has systematically built the infrastructure, governance frameworks, and investor relationships necessary to compete on a global stage.
              </p>
              <p class="bio-text">
                His unique combination of entrepreneurial instinct and corporate discipline allows Karma Capital to remain agile and founder-led, while meeting the exacting standards expected by the world's most sophisticated allocators.
              </p>
            </div>

            <div class="the-edge">
              <span class="edge-label">THE EDGE</span>
              <p class="edge-text">
                Known for high-impact growth, Praveen previously witnessed a 40x asset expansion at Motilal Oswal Asset Management to USD 5 Billion. At Karma, he drives product strategy, distribution, and the operational excellence that institutional investors demand.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</Layout>

<style lang="scss">
  .profile-page {
    background-color: #fff;
    min-height: 100vh;
  }

  .profile-hero {
    padding-top: 120px;
    padding-bottom: 3rem;
    border-bottom: 1px solid #eaeaea;

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
  }

  .back-link {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #555;
    text-decoration: none;
    transition: color 0.3s ease;

    &:hover {
      color: #9acb32;
    }
  }

  .profile-body {
    padding: 6rem 0 8rem;

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 6rem;
    align-items: start;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .profile-left {
    position: sticky;
    top: 120px;
  }

  .profile-img-wrap {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid #d0d0d0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .profile-name {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 300;
    color: #1c2229;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .profile-title {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 0.4rem;
  }

  .profile-subtitle {
    font-size: 0.95rem;
    font-style: italic;
    color: #888;
    font-weight: 300;
  }

  .profile-right {
    padding-top: 1rem;
  }

  .bio-section {
    margin-bottom: 4rem;
  }

  .bio-text {
    font-size: 1.1rem;
    line-height: 1.85;
    color: #444;
    margin-bottom: 1.8rem;
    font-weight: 300;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .the-edge {
    border-top: 1px solid #eaeaea;
    padding-top: 2.5rem;
  }

  .edge-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #9acb32;
    margin-bottom: 1.2rem;
  }

  .edge-text {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #555;
    font-weight: 300;
    font-style: italic;
  }
</style>
