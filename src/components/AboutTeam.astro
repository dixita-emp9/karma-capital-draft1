---
import rushabhImg from '../assets/images/rushabh-sheth.jpg';
import nikhilImg from '../assets/images/nikhil-desai.jpg';
import praveenImg from '../assets/images/praveen-ladia.jpg';

const teamMembers = [
  {
    name: "Rushabh Sheth",
    title: "CO-FOUNDER & CO-CIO",
    image: rushabhImg.src,
    slug: "rushabh-sheth"
  },
  {
    name: "Nikhil Desai",
    title: "CO-FOUNDER & CO-CIO",
    image: nikhilImg.src,
    slug: "nikhil-desai"
  },
  {
    name: "Praveen Ladia",
    title: "CHIEF EXECUTIVE OFFICER",
    subtitle: "The Architect of Scale",
    image: praveenImg.src,
    slug: "praveen-ladia"
  }
];
---

<section class="team-section bg-light" id="investment-core">
  <div class="container">
    
    <div class="section-header text-center mb-5">
      <h2 class="text-display-3 text-primary">The <span class="text-highlight">Investment Core</span></h2>
    </div>

    <!-- Team Grid -->
    <div class="team-grid">
      {teamMembers.map(member => (
        <div class="team-card">
          <div class="team-img-wrapper">
            <img src={member.image} alt={member.name} class="placeholder-bg" />
          </div>
          <div class="team-content">
            <h3 class="team-name text-primary">{member.name}</h3>
            <p class="team-title text-accent">{member.title}</p>
            <a href={`/karma-capital/team/${member.slug}`} class="see-profile-link">SEE PROFILE</a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style lang="scss">
  .team-section {
    padding: 5rem 0;
    background-color: #f7f9fa;
    scroll-margin-top: 80px; /* Offset for fixed header */
  }

  .text-display-3 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
  }
  
  .text-highlight {
    color: #9acb32; /* Lime green */
  }

  .text-accent {
    color: #75b0e2; /* Blue */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .mb-5 {
    margin-bottom: 4rem;
  }

  /* Team Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;

    @media (max-width: 992px) {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .team-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .team-img-wrapper {
    width: 100%;
    height: 450px;
    background-color: #e0e0e0;
    overflow: hidden;
    margin-bottom: 1.5rem;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Fallback if image not found */
    .placeholder-bg {
      background-color: #e0e0e0;
      position: relative;
      
      &::after {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(45deg, #f0f0f0 25%, transparent 25%, transparent 75%, #f0f0f0 75%, #f0f0f0), linear-gradient(45deg, #f0f0f0 25%, transparent 25%, transparent 75%, #f0f0f0 75%, #f0f0f0);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
        opacity: 0.5;
      }
    }
  }

  .team-content {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #333;
    padding-top: 1.5rem;
  }

  .team-name {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
    font-weight: 300;
  }

  .see-profile-link {
    color: #9acb32; /* Lime green */
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: opacity 0.3s ease;
    margin-top: auto;
    
    &:hover {
      opacity: 0.8;
    }
  }
</style>
