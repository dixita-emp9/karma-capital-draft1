---
import logoWhite from '../assets/Karma Capital-White.png';
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      
      <!-- Column 1 -->
      <div class="footer-col brand-col">
        <div class="logo">
          <a href={baseUrl} aria-label="Karma Capital Home">
            <img src={logoWhite.src} alt="Karma Capital" class="logo-img" style="filter: invert(1);" />
          </a>
        </div>
        <p class="tagline font-secondary">Independent thinking. Disciplined research. Enduring wealth.</p>
        <div class="social-links">
          <a href="#" aria-label="X (Twitter)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2 -->
      <div class="footer-col">
        <h4>About Us</h4>
        <ul>
          <li><a href="#">About the Firm</a></li>
          <li><a href="#">The Karma Capital Advantage</a></li>
          <li><a href="#">Leadership Team</a></li>
          <li><a href="#">Investment Offerings</a></li>
          <li><a href="#">Contact Us</a></li>
        </ul>
      </div>

      <!-- Column 3 -->
      <div class="footer-col">
        <h4>Investment Solutions</h4>
        <ul>
          <li><a href="#">Karma Capital Wealth Builder PMS</a></li>
          <li><a href="#">Karma Capital India AIF</a></li>
          <li><a href="#">GIFT City Fund</a></li>
        </ul>
      </div>

      <!-- Column 4 -->
      <div class="footer-col">
        <h4>Regulatory Information</h4>
        <p>Karma Capital Advisors Pvt Ltd</p>
        <p>CIN: U67190MH2004PTC148102</p>
        <p>SEBI PMS Reg No: INP000001223</p>
        <p>AIF Cat III Reg: IN/AIF3/18-19/0598</p>
        
        <div class="contact-info mt-4">
          <p><strong>Our Phone:</strong> +91 22 62 32 7200</p>
          <p><strong>Our Email:</strong> marketing@karmacapital.co.in</p>
        </div>
      </div>
      
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Karma Capital Advisors Pvt Ltd.</p>
      <div class="legal-links">
        <a href="#">Disclaimer</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    background-color: #f6f5f2; /* Updated background color */
    color: #000000;
    padding: 6rem 0 2rem;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .logo-img {
    height: 55px;
    width: auto;
    margin-bottom: 1.5rem;
    display: block;
    transition: transform 0.3s ease, opacity 0.3s ease;

    &:hover {
      transform: scale(1.03);
      opacity: 0.9;
    }
  }

  .tagline {
    font-size: 1.05rem;
    opacity: 0.7;
    margin-bottom: 2rem;
    line-height: 1.6;
    max-width: 300px;
    font-weight: 300;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    
    a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 1px solid rgba(0,0,0,0.1);
      border-radius: 50%;
      color: #000000;
      transition: all 0.3s ease;
      
      &:hover {
        background: #9acb32; /* Lime green */
        color: #fff;
        border-color: #9acb32;
      }
    }
  }

  .footer-col {
    h4 {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
      color: #000000;
    }
    
    ul {
      list-style: none;
      
      li {
        margin-bottom: 0.8rem;
        
        a {
          color: rgba(0, 0, 0, 0.7);
          text-decoration: none;
          transition: color 0.3s;
          font-family: var(--font-secondary);
          font-size: 0.95rem;
          
          &:hover {
            color: #9acb32;
          }
        }
      }
    }

    p {
      color: rgba(0, 0, 0, 0.7);
      margin-bottom: 0.5rem;
      font-family: var(--font-secondary);
      font-size: 0.95rem;
    }
  }

  .mt-4 {
    margin-top: 2rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(0,0,0,0.05);
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.5);
    
    .legal-links {
      display: flex;
      gap: 1.5rem;
      
      a {
        color: rgba(0, 0, 0, 0.5);
        &:hover {
          color: #9acb32;
        }
      }
    }
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
