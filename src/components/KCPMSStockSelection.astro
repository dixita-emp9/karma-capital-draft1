---
---
<section class="selection-section">
  <div class="container">
    <div class="section-header">
      <div class="header-left">
        <h2 class="text-display-3">What we <span style="color: #9acb32;">look for</span></h2>
      </div>
      <div class="header-right">
        <p class="font-secondary intro-text">
          The focus is simple: identify businesses with the potential to deliver sustained earnings growth, where the opportunity is supported by a meaningful margin of safety. When the fundamentals and valuation align, back them with conviction.
        </p>
      </div>
    </div>

    <div class="divider" style="height: 1px; background-color: #eaeaea; width: 100%; margin: 1rem 0 3rem 0;"></div>

    <div class="features-row">
      <div class="feature-item">
        <div class="item-number">01</div>
        <h4 class="feature-title">Business Quality</h4>
        <p class="feature-text font-secondary">Scalable, capital-efficient businesses with durable competitive advantages, strong market positions, and the potential for sustainably improving returns on capital.</p>
      </div>
      <div class="feature-item">
        <div class="item-number">02</div>
        <h4 class="feature-title">Management Alignment</h4>
        <p class="feature-text font-secondary">Long-term vision, high standards of governance, and a demonstrated ability to execute and scale the business responsibly. Alignment of interests and integrity are fundamental to the investment process.</p>
      </div>
      <div class="feature-item">
        <div class="item-number">03</div>
        <h4 class="feature-title">Valuation Discipline</h4>
        <p class="feature-text font-secondary">Great businesses are not necessarily great investments at any price. Deploy capital only when intrinsic value provides an appropriate margin of safety, using sector-specific valuation frameworks that evolve with the underlying business and market environment.</p>
      </div>
    </div>

    <div class="divider" style="height: 1px; background-color: #eaeaea; width: 100%; margin: 3rem 0;"></div>

    <div class="outro-content">
      <p class="font-secondary outro-text">We are not seeking average businesses simply because they appear inexpensive.</p>
      <p class="font-secondary outro-text">We seek businesses where quality, growth, and valuation converge and the fundamental strength can translate into sustained alpha over time.</p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Initialize animations once the DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    const featureItems = gsap.utils.toArray('.selection-section .feature-item');
    const outroContent = document.querySelector('.selection-section .outro-content');
    
    let mm = gsap.matchMedia();

    // Desktop animation (Pinned sequential reveal)
    mm.add("(min-width: 993px)", () => {
      gsap.set(featureItems, { opacity: 0, y: 50 });
      gsap.set(outroContent, { opacity: 0, y: 30 });
      
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".selection-section",
          start: "top 120px", 
          end: "+=1500", // slightly longer for the extra element
          pin: true,
          scrub: 1, 
        }
      });

      tl.to(featureItems[0], { opacity: 1, y: 0, duration: 1 })
        .to({}, { duration: 0.2 }) 
        .to(featureItems[1], { opacity: 1, y: 0, duration: 1 })
        .to({}, { duration: 0.2 }) 
        .to(featureItems[2], { opacity: 1, y: 0, duration: 1 })
        .to({}, { duration: 0.3 })
        .to(outroContent, { opacity: 1, y: 0, duration: 1 })
        .to({}, { duration: 0.5 });
    });

    // Mobile animation (Simple scroll-up reveal)
    mm.add("(max-width: 992px)", () => {
      featureItems.forEach(item => {
        gsap.fromTo(item, 
          { opacity: 0, y: 50 },
          {
            scrollTrigger: {
              trigger: item as Element,
              start: "top 85%",
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power2.out"
          }
        );
      });
      
      gsap.fromTo(outroContent, 
        { opacity: 0, y: 30 },
        {
          scrollTrigger: {
            trigger: outroContent as Element,
            start: "top 85%",
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power2.out"
        }
      );
    });
  });
</script>

<style lang="scss">
  .selection-section {
    padding: 8rem 0;
    background-color: #ffffff;
    color: #333;
  }
  
  .section-header {
    display: flex;
    gap: 4rem;
    margin-bottom: 4rem;
    
    @media (max-width: 768px) {
      flex-direction: column;
      gap: 2rem;
    }
  }

  .header-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .header-right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .text-display-3 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 0;
    color: #1a1a1a;
  }

  .intro-text {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #555;
    margin: 0;
  }

  .features-row {
    display: flex;
    justify-content: space-between;
    gap: 4rem;
    padding-top: 2rem;
    
    @media (max-width: 992px) {
      flex-direction: column;
      gap: 4rem;
    }
  }

  .feature-item {
    flex: 1;
    min-width: 250px;
  }

  .item-number {
    font-size: 5rem;
    font-weight: 300;
    line-height: 1;
    color: #75b0e2 !important;
    margin-bottom: 1.5rem;
    font-family: 'Inter', sans-serif;
  }

  .feature-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: #1a1a1a;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .feature-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #666;
    margin: 0;
  }
  
  .outro-content {
    margin-top: 1rem;
    text-align: center;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .outro-text {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #555;
    font-weight: 400;
    margin-bottom: 1.5rem;
    
    &:last-child {
      margin-bottom: 0;
    }
  }
</style>
