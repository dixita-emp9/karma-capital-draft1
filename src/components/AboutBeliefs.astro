---
const funnelLayers = [
  {
    title: "The Mindset",
    subtitle: "Independent Thinking",
    desc: "Deviating from the benchmark to capture alpha. Proprietary research uncovers value where the broader market sees ambiguity.",
    width: "100%",
    bg: "#eef4f9"
  },
  {
    title: "The Search",
    subtitle: "Unconstrained Discovery",
    desc: "A mandate without boundaries. Identifying high-growth leaders early in their cycle to secure a strategic valuation advantage.",
    width: "85%",
    bg: "#dceaf5"
  },
  {
    title: "The Execution",
    subtitle: "Concentrated Conviction",
    desc: "Quality over quantity. The investment universe is distilled into a focused portfolio of highest-conviction bets, rejecting the safety of over-diversification.",
    width: "70%",
    bg: "#cadff0"
  },
  {
    title: "The Horizon",
    subtitle: "Stability through perspective",
    desc: "Ignoring temporary noise to secure<br/>sustainable, multi-cycle compounding.",
    width: "55%",
    bg: "#b5d4ec"
  }
];
---

<section class="beliefs-section bg-white">
  <div class="container">
    
    <div class="section-header text-center mb-5" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
      <h2 class="text-display-3 text-primary mb-3" style="margin: 0; text-align: center;">Core <span class="text-highlight">Beliefs</span></h2>
      <p class="section-subtitle font-secondary mx-auto" style="margin-top: 0.5rem; text-align: center;">A process of elimination - filtering the noisy market down to high conviction ideas.</p>
    </div>

    <div class="funnel-master-container">
      {funnelLayers.map((layer, index) => (
        <div class={`funnel-segment segment-${index + 1}`} style={`background-color: ${layer.bg};`}>
          <div class="layer-content">
            <div class="layer-header">
              <span class="layer-num font-secondary">0{index + 1}</span>
              <h3 class="layer-title text-primary">{layer.title}</h3>
              <div class="layer-divider"></div>
            </div>
            <p class="layer-subtitle font-secondary"><strong>{layer.subtitle}.</strong> <span set:html={layer.desc}></span></p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style lang="scss">
  .beliefs-section {
    padding: 8rem 0;
    background-color: #ffffff;
  }

  .text-display-3 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
  }
  
  .text-highlight {
    color: #9acb32; /* Lime green */
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: #666;
    margin-top: 1rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .mb-5 {
    margin-bottom: 5rem;
  }

  /* Funnel Styles - Continuous Clip Path */
  .funnel-master-container {
    display: flex;
    flex-direction: column;
    max-width: 1000px;
    margin: 0 auto;
    /* This creates a continuous funnel shape */
    clip-path: polygon(0 0, 100% 0, 75% 100%, 25% 100%);
    background-color: #f7f9fa; /* Fallback */
    box-shadow: inset 0 0 20px rgba(0,0,0,0.05);
    
    @media (max-width: 768px) {
      clip-path: none; /* Disable clip path on mobile for readability */
      border-radius: 12px;
      overflow: hidden;
    }
  }

  .funnel-segment {
    padding: 3.5rem 2rem;
    text-align: center;
    position: relative;
    transition: background-color 0.3s ease;
    
    /* Add a subtle top border to separate layers */
    &:not(:first-child)::before {
      content: '';
      position: absolute;
      top: 0;
      left: 10%;
      right: 10%;
      height: 1px;
      background: rgba(255,255,255,0.5);
    }
    
    &:hover {
      /* Slight darkening on hover to make it interactive */
      filter: brightness(0.97);
    }
  }

  /* Progressively increase horizontal padding so text doesn't hit the angled walls */
  .segment-1 { padding-left: 8%; padding-right: 8%; }
  .segment-2 { padding-left: 15%; padding-right: 15%; }
  .segment-3 { padding-left: 22%; padding-right: 22%; }
  .segment-4 { padding-left: 28%; padding-right: 28%; }

  @media (max-width: 768px) {
    .funnel-segment { padding: 2.5rem 1.5rem !important; }
  }

  .layer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .layer-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .layer-divider {
    width: 40px;
    height: 1px;
    background-color: #75b0e2; /* Blue */
    margin-top: 0.2rem;
  }

  .layer-num {
    font-size: 1rem;
    color: #75b0e2; /* Blue */
    font-weight: 600;
    background: #fff;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }

  .layer-title {
    font-size: 1.8rem;
    font-weight: 400;
    margin: 0;
  }

  .layer-subtitle {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #444;
    margin: 0;
    max-width: 600px;
    
    strong {
      color: #111;
      font-weight: 600;
    }
  }

  .funnel-connector {
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    
    svg {
      animation: bounce 2s infinite;
    }
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(5px);
    }
    60% {
      transform: translateY(3px);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const segments = document.querySelectorAll('.funnel-segment');
  
  if (segments.length > 0) {
    gsap.fromTo(segments, 
      { 
        opacity: 0, 
        y: 40 
      },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power2.out",
        scrollTrigger: {
          trigger: ".funnel-master-container",
          start: "top 80%",
        }
      }
    );
  }
</script>
