      margin-bottom: 1.5rem;
    }
  }

  .framework-list {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin: 0;

    li {
      font-size: 1.05rem;
      line-height: 1.7;
      color: #666;
      margin-bottom: 1rem;
      
      &::marker {
