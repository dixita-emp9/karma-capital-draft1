---
const riskPrinciples = [
  {
    title: "Valuation Discipline",
    desc: "Maintain strict price sensitivity. Entering at the early stage of a cycle creates a margin of safety and reduces exposure to valuation risk.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
  },
  {
    title: "Stringent Filters",
    desc: "Set clear entry standards. Every opportunity is rigorously evaluated for liquidity, management track record, and governance practices.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>`
  },
  {
    title: "Business Resilience",
    desc: "Prioritize durability. Investments are confined to companies with strong balance sheets and business models designed to withstand volatility.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`
  }
];
---

<section class="risk-section bg-white">
  <div class="container">
    
    <div class="section-header text-left mb-5 align-top">
      <div class="row" style="display: flex; gap: 4rem;">
        <div class="col-title" style="flex: 1;">
          <h2 class="text-display-3 text-primary" style="margin: 0;">Risk <span style="color: #9acb32;">Conscious</span></h2>
        </div>
        <div class="col-desc" style="flex: 2;">
          <p class="section-subtitle font-secondary" style="margin-top: 0; max-width: none;"><strong>The Discipline of Exclusion</strong><br />Reducing risk through a structured and deliberate framework of avoidance.</p>
        </div>
      </div>
    </div>

    <!-- 3 Principles Grid -->
    <div class="risk-grid">
      {riskPrinciples.map((principle, index) => (
        <div class="risk-card">
          <div class="risk-icon" style="color: #75b0e2; margin-bottom: 1.5rem; display: block; line-height: 0;" set:html={principle.icon} />
          <h3 class="risk-title text-primary">{principle.title}</h3>
          <p class="risk-desc font-secondary">{principle.desc}</p>
        </div>
      ))}
    </div>

    <!-- The Bottom Line -->
    <div class="bottom-line-simple">
      <p class="callout-text-simple text-primary">
        Capital preservation comes from actively safeguarding portfolio quality, being selective in capital deployment and avoiding risks that are not adequately rewarded.
      </p>
    </div>

  </div>
</section>

<style lang="scss">
  .risk-section {
    padding: 8rem 0;
    background-color: #ffffff;
  }

  .text-display-3 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: #666;
    margin-top: 1.5rem;
    line-height: 1.6;
  }

  .mb-5 {
    margin-bottom: 5rem;
  }

  .risk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #eaeaea;
    margin-bottom: 5rem;

    @media (max-width: 992px) {
      grid-template-columns: 1fr;
    }
  }

  .risk-card {
    padding: 3rem 2rem;
    border-right: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
    transition: background-color 0.3s ease;
    
    &:last-child {
      border-right: none;
    }
    
    &:hover {
      background-color: #f1f2ec;
    }
  }

  .risk-title {
    font-size: 1.8rem;
    font-weight: 300;
    margin-bottom: 1.5rem;
    color: #333;
  }

  .risk-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }

  /* Bottom Line Callout */
  .bottom-line-simple {
    padding-top: 0;
    margin-bottom: 4rem;
  }

  .callout-text-simple {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 300;
    line-height: 1.5;
    margin: 0;
    color: #333;
  }
</style>
