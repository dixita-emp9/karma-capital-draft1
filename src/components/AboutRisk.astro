---
const riskPrinciples = [
  {
    title: "Valuation Discipline",
    desc: "Maintain strict price sensitivity. Entering at the early stage of a cycle creates a margin of safety and reduces exposure to valuation risk."
  },
  {
    title: "Stringent Filters",
    desc: "Set clear entry standards. Every opportunity is rigorously evaluated for liquidity, management track record, and governance practices."
  },
  {
    title: "Business Resilience",
    desc: "Prioritize durability. Investments are confined to companies with strong balance sheets and business models designed to withstand volatility."
  }
];
---

<section class="risk-section bg-light">
  <div class="container">
    
    <div class="section-header text-center mb-5">
      <h2 class="text-display-3 text-primary">Risk Conscious</h2>
      <p class="section-subtitle font-secondary">The Discipline of Exclusion<br />Reducing risk through a structured and deliberate framework of avoidance.</p>
    </div>

    <!-- 3 Principles Grid -->
    <div class="risk-grid">
      {riskPrinciples.map((principle, index) => (
        <div class="risk-card">
          <div class="risk-num font-secondary">0{index + 1}</div>
          <h3 class="risk-title text-primary">{principle.title}</h3>
          <p class="risk-desc font-secondary">{principle.desc}</p>
        </div>
      ))}
    </div>

    <!-- The Bottom Line -->
    <div class="bottom-line-callout">
      <h4 class="callout-title font-secondary">The Bottom Line</h4>
      <p class="callout-text text-primary">
        Capital preservation comes from actively safeguarding portfolio quality, being selective in capital deployment and avoiding risks that are not adequately rewarded.
      </p>
    </div>

  </div>
</section>

<style lang="scss">
  .risk-section {
    padding: 8rem 0;
    background-color: #f7f9fa; /* Match the team section bg */
  }

  .text-display-3 {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: #666;
    margin-top: 1.5rem;
    line-height: 1.6;
  }

  .mb-5 {
    margin-bottom: 5rem;
  }

  .risk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-bottom: 5rem;

    @media (max-width: 992px) {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .risk-card {
    background: #fff;
    padding: 3rem 2.5rem;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    border-top: 4px solid transparent;
    transition: all 0.3s ease;

    &:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
      border-top-color: #9acb32; /* Lime green hover indicator */
    }
  }

  .risk-num {
    font-size: 2.5rem;
    color: #f0f0f0;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 1rem;
    transition: color 0.3s ease;
  }

  .risk-card:hover .risk-num {
    color: #e0f0cc;
  }

  .risk-title {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .risk-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #666;
    margin: 0;
  }

  /* Bottom Line Callout */
  .bottom-line-callout {
    background: linear-gradient(135deg, #1c2229 0%, #2a333d 100%);
    border-radius: 8px;
    padding: 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;

    &::before {
      content: '"';
      position: absolute;
      top: 10px;
      left: 30px;
      font-size: 10rem;
      color: rgba(255,255,255,0.03);
      font-family: serif;
      line-height: 1;
    }
  }

  .callout-title {
    color: #9acb32; /* Lime green */
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
  }

  .callout-text {
    color: #fff !important; /* Override text-primary */
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 300;
    line-height: 1.5;
    margin: 0;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
