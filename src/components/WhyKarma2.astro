---
const principles = [
  {
    title: "Independent Asset Manager",
    description: "Free from institutional conflicts. With no proprietary trading or ancillary business lines, the sole focus is the fiduciary duty of managing discretionary capital.",
    num: "01"
  },
  {
    title: "Proven Resilience",
    description: "Demonstrated capability across two decades of market cycles. Since 2005, the firm has navigated volatility with a consistent philosophy, delivering superior risk adjusted returns.",
    num: "02"
  },
  {
    title: "The 'Early Cycle' Edge",
    description: "High active share strategies designed to generate alpha. Rigorous bottom-up research identifies mispriced opportunities early, distinguishing the portfolio from the broader benchmark.",
    num: "03"
  }
];
---

<section class="why-karma-2" id="about">
  <div class="container">
    <div class="wk-header">
      <h2 class="section-title text-display-2 reveal-text">Why Karma Capital?</h2>
      <div class="header-line"></div>
    </div>

    <div class="wk-grid">
      {principles.map((principle, i) => (
        <div class="wk-card reveal-card">
          <div class="card-inner">
            <div class="card-top">
              <span class="card-label font-secondary">PRINCIPLE</span>
              <span class="card-num font-secondary">{principle.num}</span>
            </div>
            <h3 class="card-title">{principle.title}</h3>
            <div class="card-desc-wrapper">
              <p class="card-desc text-body-large">{principle.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .why-karma-2 {
    padding: var(--spacing-section, 8rem) 0;
    background-color: var(--color-background);
  }

  .wk-header {
    margin-bottom: 4rem;
    
    .section-title {
      margin-bottom: 2rem;
    }
    
    .header-line {
      width: 100%;
      height: 1px;
      background-color: var(--color-border);
    }
  }

  .wk-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px; /* For thin borders between cards */
    background-color: var(--color-border); /* Acts as border */
    border: 1px solid var(--color-border);
    
    @media (min-width: 768px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .wk-card {
    background-color: var(--color-background);
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: background-color 0.4s ease;
    min-height: 350px;
    display: flex;
    flex-direction: column;

    &:hover {
      background-color: #f0ebd8; /* Subtle highlight color */
      
      .card-desc-wrapper {
        opacity: 1;
        transform: translateY(0);
      }
      
      .card-title {
        transform: translateY(-10px);
      }
    }
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .card-label {
    background-color: var(--color-text);
    color: var(--color-background);
    padding: 0.2rem 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 1px;
  }

  .card-num {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .card-title {
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 300;
    line-height: 1.2;
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .card-desc-wrapper {
    margin-top: 2rem;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .card-desc {
    color: #555;
    font-size: 1rem;
    line-height: 1.5;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.why-karma-2 .reveal-text').forEach((text: any) => {
    gsap.fromTo(text,
      { y: 30, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: text,
          start: "top 85%",
        }
      }
    );
  });

  gsap.from('.why-karma-2 .reveal-card', {
    scrollTrigger: {
      trigger: '.wk-grid',
      start: 'top 85%'
    },
    y: 40,
    opacity: 0,
    duration: 1,
    stagger: 0.15,
    ease: "power3.out"
  });
</script>
