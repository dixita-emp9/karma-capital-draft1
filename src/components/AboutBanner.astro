---
---

<section class="about-hero-section">
  <div class="hero-parallax-wrapper">
    <div class="hero-bg" style="background-image: url('/images/hero_boutique.jpg');"></div>
    <div class="hero-overlay"></div>
  </div>
  
  <div class="container hero-content">
    <div class="hero-content-inner">
      <h1 class="hero-title text-display-1">
        <span class="line"><span class="line-inner">20 years of</span></span>
        <span class="line"><span class="line-inner text-highlight">Good Karma.</span></span>
      </h1>
      
      <div class="content-block">
        <p class="hero-subtitle text-body-large"><strong style="font-weight: 500;">Doing It Right.</strong> At Karma Capital we believe that good intent drives positive outcomes.</p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .about-hero-section {
    position: relative;
    height: 70vh; /* Slightly shorter than home page hero */
    width: 100vw;
    overflow: hidden;
    background-color: var(--color-primary);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-parallax-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 0;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    color: white;
    width: 100%;
    margin-top: 5rem;
  }

  .hero-content-inner {
    margin: 0;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-title {
    margin-bottom: 2rem;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.1;
    font-weight: 300;
    
    .line {
      display: block;
      overflow: hidden;
      padding-bottom: 0.2em; 
      margin-bottom: -0.2em;
    }
    
    .line-inner {
      display: block;
      transform: translateY(110%);
      animation: revealUp 1.2s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    }
    
    .line:nth-child(2) .line-inner {
      animation-delay: 0.15s;
    }
  }

  .content-block {
    width: 90%;
    min-width: 300px;
  }

  .hero-subtitle {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 1s cubic-bezier(0.19, 1, 0.22, 1) forwards;
    animation-delay: 0.5s;
    font-weight: 300;
    line-height: 1.6;
    font-size: clamp(1.1rem, 1.25vw, 1.3rem);
  }

  @keyframes revealUp {
    to {
      transform: translateY(0);
    }
  }

  @keyframes fadeUp {
    to {
      opacity: 0.9;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .content-block {
      width: 100%;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.hero-parallax-wrapper').forEach((wrapper: any) => {
    gsap.to(wrapper, {
      y: () => window.innerHeight / 2,
      ease: "none",
      scrollTrigger: {
        trigger: ".about-hero-section",
        start: "top top",
        end: "bottom top",
        scrub: true,
        invalidateOnRefresh: true
      }
    });
  });
</script>
