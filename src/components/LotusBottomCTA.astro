<section class="bottom-cta-section bg-white">
  <div class="container">
    <div class="cta-block text-center-wrapper">
      <div class="centered-content">
        <p class="cta-text font-secondary">
          <strong>Partner with Experience.</strong> Backed by a 20-year track record
          and over 125+ years of combined investment experience.
        </p>

        <div
          class="contact-divider"
          style="border-top: 1px solid #e5e7eb; margin: 2.5rem 0; width: 100%;"
        >
        </div>

        <h4 class="contact-heading font-secondary" style="margin-bottom: 1rem;">
          Contact Investment Team
        </h4>

        <div class="contact-details font-secondary">
          <div
            class="contact-item"
            style="display: flex; align-items: center; margin-bottom: 1rem;"
          >
            <span
              class="contact-icon"
              style="margin-right: 12px; display: flex; align-items: center; justify-content: center; color: #75b0e2;"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M4 7.00005L10.2 11.65C11.2667 12.45 12.7333 12.45 13.8 11.65L20 7"
                ></path><rect x="3" y="5" width="18" height="14" rx="2"
                ></rect></svg
              >
            </span>
            <a
              href="mailto:marketing@karmacapital.co.in"
              class="contact-link"
              style="color: #000; font-weight: bold; text-decoration: none;"
              >marketing@karmacapital.co.in</a
            >
          </div>
          <div class="contact-item" style="display: flex; align-items: center;">
            <span
              class="contact-icon"
              style="margin-right: 12px; display: flex; align-items: center; justify-content: center; color: #75b0e2;"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
            </span>
            <span class="contact-text" style="color: #000; font-weight: bold;"
              >+91-22-6232-7200</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .bottom-cta-section {
    padding: 6rem 0 8rem 0;
    background-color: #ffffff;
  }

  .cta-block {
    padding: 0;
  }

  .centered-content {
    max-width: 1000px;
    margin: 0 auto;
    text-align: left;
    padding: 3rem 4rem;

    .contact-details {
      display: flex;
      gap: 3rem;
      align-items: flex-start;
      margin-top: 1.5rem;

      @media (max-width: 576px) {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
    }

    @media (max-width: 768px) {
      padding: 2rem 0;
    }
  }

  .cta-text {
    font-size: 1.25rem;
    line-height: 1.8;
    color: #444;
    margin: 0;

    strong {
      color: #1a1a1a;
      font-weight: 600;
    }
  }

  .contact-heading {
    font-size: 1.2rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .contact-link {
    color: #555;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 500;
    transition: color 0.3s ease;

    &:hover {
      color: #75b0e2;
    }
  }

  .contact-text {
    color: #555;
    font-size: 1.1rem;
    font-weight: 500;
  }
</style>
